#! /bin/sh

function do_colour () {
    infile=$1
    lexer=$2

    if [ -n "${lexer}" ]; then
        lexer="-l $lexer"
    fi

    pygmentize ${lexer} "$1"
    exit $?
}

case "$1" in
    *.md|*.markdown)
        # Render markdown with glow. Use an explicit style so glow emits ANSI even
        # though its stdout is a pipe here (it suppresses colour for non-TTY output
        # unless a style is given). Fall back to raw (exit 1) if glow isn't present.
        command -v glow >/dev/null 2>&1 || exit 1
        glow -s dark "$1"
        exit $?
        ;;
    *.c|*.sh|*.cc|*.cpp|*.h|*.H|*.pl|*.py|*.R|*.patch)
        do_colour "$1"
        ;;
    *.f90|*.F90|*.f)
        do_colour "$1" "fortran"
        ;;
    *.exp)
        do_colour "$1" "tcl"
        ;;
    ?*.*)
        exit 1
        ;;
    *)
        break
        ;;
esac

type=$(file -b -L -i $1)
case $type in
    text/x-shellscript\;*|text/x-perl\;*|text/x-python\;*)
        do_colour "$1"
        ;;
    *)
        exit 1
        ;;
esac
